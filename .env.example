# ==============================================================================
# EventSpot - Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug

# Service Ports & Hosts (External / Local Dev)
GATEWAY_PORT=3000
INGESTION_PORT=3001
RECOMMENDATION_PORT=3002
FRONTEND_PORT=5173
CLIENT_URL=http://127.0.0.1:5173

# Internal Service URLs (Used by api-gateway and inter-service HTTP)
INGESTION_SERVICE_URL=http://localhost:3001
RECOMMENDATION_SERVICE_URL=http://localhost:3002

# MongoDB Database (TTL Indexes & Cache)
MONGODB_URI=mongodb://localhost:27017/eventspot

# Security & Encryption (AES-256-GCM - exactly 32 bytes hex string = 64 characters)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=eventspot_session_secret_min_32_characters_random
COOKIE_SECRET=eventspot_cookie_secret_min_32_characters_random

# Spotify OAuth 2.0 PKCE Configuration
# https://developer.spotify.com/dashboard
# IMPORTANT: Spotify forbids "localhost" - use explicit loopback IP 127.0.0.1!
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/v1/auth/callback
SPOTIFY_SCOPES=user-read-recently-played user-read-currently-playing

# Ticketmaster Discovery API v2
# https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# JamBase Concert Data API v3 (Optional multi-source aggregator: Ticketmaster+Eventbrite+DICE+AXS)
# https://data.jambase.com/
JAMBASE_API_KEY=your_jambase_api_key_optional

# Open Schema.org JSON-LD Venue Calendars (Comma-separated URLs, zero API key required)
EVENT_FEED_URLS=
ENABLE_FREE_EVENT_ADAPTERS=true

# Open-Meteo API (No API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Optional Secondary Tag Enrichment (Fallback when Spotify genres: [])
LASTFM_API_KEY=your_lastfm_api_key_optional

# Context-Driven Scoring Weights (Normal Mode: sum = 1.0)
WEIGHT_SESSION_SEMANTIC=0.40
WEIGHT_TIME_CONGRUENCE=0.20
WEIGHT_SPATIAL_DECAY=0.30
WEIGHT_WEATHER_COMPATIBILITY=0.10

# Fallback Scoring Weights (Empty Session / Missing Context: sum = 1.0)
FALLBACK_WEIGHT_TIME=0.30
FALLBACK_WEIGHT_SPATIAL=0.55
FALLBACK_WEIGHT_WEATHER=0.15

# Mock Providers Toggle (Set to true to test locally without live Spotify/Ticketmaster keys)
MOCK_EXTERNAL_PROVIDERS=true
